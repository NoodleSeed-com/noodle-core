{
  "name": "@noodle-borg/assistant-gateway",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@noodle-borg/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./portable": {
      "@noodle-borg/source": "./src/portable.ts",
      "types": "./dist/portable.d.ts",
      "import": "./dist/portable.js"
    },
    "./model-runtime": {
      "@noodle-borg/source": "./src/model-runtime.ts",
      "types": "./dist/model-runtime.d.ts",
      "import": "./dist/model-runtime.js"
    },
    "./postgres": {
      "@noodle-borg/source": "./src/postgres.ts",
      "types": "./dist/postgres.d.ts",
      "import": "./dist/postgres.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@noodle-borg/admission-limits": "workspace:*",
    "@noodle-borg/app-package": "workspace:*",
    "@noodle-borg/compiler": "workspace:*",
    "@noodle-borg/connector-defs": "workspace:*",
    "@noodle-borg/module": "workspace:*",
    "@noodle-borg/module-audit": "workspace:*",
    "@noodle-borg/protocol": "workspace:*",
    "@noodle-borg/runtime": "workspace:*",
    "@noodleseed/assistant": "workspace:*",
    "pg": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.1",
    "@types/pg": "^8.20.0"
  }
}
