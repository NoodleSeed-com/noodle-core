{
  "name": "@noodle-borg/runtime",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@noodle-borg/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./postgres": {
      "@noodle-borg/source": "./src/postgres.ts",
      "types": "./dist/postgres.d.ts",
      "import": "./dist/postgres.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@noodle-borg/managed-capabilities": "workspace:*",
    "@noodle-borg/compiler": "workspace:*",
    "@noodle-borg/module": "workspace:*",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.1",
    "@types/pg": "^8.20.0"
  }
}
